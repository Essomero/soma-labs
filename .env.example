# ==============================================================================
# Soma Labs — Environment Configuration Template (.env.example)
#
# Setup: cp .env.example .env   (gitignored, local overrides only)
#
# Rule: labs need no secrets and no .env to run.
# Everything below is an OPTIONAL override with a working default.
# `npm install` runs `npm run doctor`, which reports exactly which
# tracks are runnable on your machine before you run anything.
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTIONAL — SQL practice kit overrides (scripts/sql-practice.sh)
# ------------------------------------------------------------------------------

# Force backend: local | docker (default: auto-detect, local Postgres first)
SQL_PRACTICE_MODE=

# Port for the disposable scratch cluster (default: 55432, walks up if taken)
SQL_PRACTICE_PORT=

# Database name inside the scratch cluster (default: drills)
SQL_PRACTICE_DB=

# Data directory for the local cluster (default: pg/drills, gitignored)
SQL_PRACTICE_DATA=

# Prebuilt kit download URL (default: the published copy under /sql/)
SQL_PRACTICE_KIT_URL=

# Docker container name when running in docker mode (default: sqldrills)
SQL_PRACTICE_CONTAINER=

# ------------------------------------------------------------------------------
# Docker Compose defaults (docker-compose.yml) — committed, not secrets
# ------------------------------------------------------------------------------
# Local-only Postgres 16 + seed credentials for reporting drills:
#   user: toggl / password: togglpassword / db: toggldb / port: 5432
# These never leave your machine. Change them in docker-compose.yml directly;
# there is nothing to configure here.
