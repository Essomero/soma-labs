{
  "name": "fullstack-02-generics",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lab": "deno run -A lab.ts",
    "tour": "deno run -A lab.ts --tour",
    "lab:step": "deno run -A lab.ts --step",
    "lab:probe-1": "deno run -A lab.ts probe 1",
    "lab:probe-2": "deno run -A lab.ts probe 2",
    "lab:probe-3": "deno run -A lab.ts probe 3",
    "lab:relationship": "deno run -A lab.ts --topic=relationship",
    "lab:constraints": "deno run -A lab.ts --topic=constraints",
    "typecheck": "deno check --node-modules-dir=auto lab.ts src/*.ts",
    "test": "deno test -A --node-modules-dir=auto tests/*.test.ts",
    "test:lesson": "deno test -A --node-modules-dir=auto tests/relationship.test.ts tests/constraints.test.ts",
    "test:relationship": "deno test -A --node-modules-dir=auto tests/relationship.test.ts",
    "test:constraints": "deno test -A --node-modules-dir=auto tests/constraints.test.ts",
    "test:p1": "deno test -A --node-modules-dir=auto tests/p1_constrained_wrapper.test.ts",
    "test:p2": "deno test -A --node-modules-dir=auto tests/p2_over_generalized.test.ts",
    "test:p3": "deno test -A --node-modules-dir=auto tests/p3_build_pick.test.ts"
  }
}
